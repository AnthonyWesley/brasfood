# Segredo que assina o JWT da sessão. Obrigatório em produção.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# true mostra o preço por caixa no portal. Ainda a definir com a Brasfood.
PORTAL_SHOW_PRICES=false

# Quem recebe o aviso de novo cadastro (por enquanto só aparece no log do servidor).
ADMIN_NOTIFY_EMAIL=

# Backend Node (próxima etapa). Enquanto vazio, o front usa os dados de exemplo.
API_URL=
